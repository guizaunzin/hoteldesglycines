# Copiez ce fichier en .env.local et remplissez les valeurs. Ne commitez jamais .env.local.

# --- Obligatoire en production ---------------------------------------------
# Secret servant à chiffrer l'état de la partie stocké dans le navigateur.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GAME_STATE_SECRET=

# --- Dialogues par IA (optionnel) -----------------------------------------
# Sans clé, le jeu tourne en MODE DÉMONSTRATION (répliques pré-écrites, clairement signalé).
ANTHROPIC_API_KEY=
# Modèle utilisé pour les personnages (défaut : claude-opus-5-5).
# Pour réduire coût/latence : claude-sonnet-5-5 ou claude-haiku-5-5.
ANTHROPIC_MODEL=
# Forcer le mode démonstration même avec une clé : AI_PROVIDER=demo
AI_PROVIDER=

# --- Voix côté serveur (optionnel) -----------------------------------------
# Sans clé, la reconnaissance et la synthèse vocales utilisent le navigateur (Web Speech API).
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
